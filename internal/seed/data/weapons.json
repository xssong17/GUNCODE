{
  "meta": {
    "game": "三角洲行动 (Delta Force)",
    "datasetVersion": "2026-10-24",
    "description": "枪械分类与基础信息数据集。本文件是本应用枪械库的唯一数据源，Go 种子代码据此初始化数据库。",
    "categories": [
      { "id": "ar", "name": "突击步枪", "order": 1 },
      { "id": "dmr", "name": "射手步枪", "order": 2 },
      { "id": "sniper", "name": "狙击步枪", "order": 3 },
      { "id": "lmg", "name": "轻机枪", "order": 4 },
      { "id": "smg", "name": "冲锋枪", "order": 5 },
      { "id": "shotgun", "name": "霰弹枪", "order": 6 },
      { "id": "pistol", "name": "手枪", "order": 7 },
      { "id": "special", "name": "特殊武器", "order": 8 }
    ],
    "modes": [
      {
        "id": "op",
        "name": "烽火地带",
        "codePrefixRequired": true,
        "codeTemplate": "{inGameName}-烽火地带-{payload}",
        "note": "导入游戏时必须保留 武器全名-烽火地带- 前缀，否则导入失败；配枪偏性价比。"
      },
      {
        "id": "ww",
        "name": "全面战场",
        "codePrefixRequired": false,
        "codeTemplate": "{payload}",
        "note": "直接粘贴裸码即可；配枪偏大弹匣、持续交火。"
      }
    ],
    "fields": {
      "id": "稳定英文标识，用于前端 key / 路由 / 关联",
      "name": "型号简称，界面主要展示",
      "inGameName": "游戏内武器全名（含品类后缀），用于拼接烽火地带分享码前缀",
      "category": "所属分类 id，见 categories",
      "aliases": "其它常见叫法，搜索时一并匹配",
      "caliber": "口径/弹药，未核实填 null",
      "status": "available=确认存在 | unverified=来源为第三方数据待核实 | removed=疑似已下架",
      "source": "official=官方开服公告佐证 | db=第三方武器库/改枪码站 | unverified=仅有间接线索",
      "note": "备注"
    },
    "caveats": [
      "三角洲武器随赛季增删，本数据集为 2026-10 快照，新赛季后需人工核对游戏内【军械库/武器手册】。",
      "标注 source=db / status=unverified 的条目需在游戏内确认后再对外发布。",
      "inGameName 存在品类后缀特例（如 M7 为『M7战斗步枪』而非『M7突击步枪』），已按实际写法记录。"
    ]
  },

